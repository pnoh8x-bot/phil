{
 "manifest_version":3,"name":"NBA Draft Helper — Yahoo Browser Sync","version":"0.2.1",
 "background":{"service_worker":"background.js"},
 "description":"Read displayed Yahoo Fantasy tables and sync to NBA Draft Helper. No Yahoo API or cookies.",
 "permissions":["storage"],
 "action":{"default_popup":"popup.html"},
 "content_scripts":[
  {"matches":["https://basketball.fantasysports.yahoo.com/nba/*","https://basketball.fantasysports.yahoo.com/draftclient/nba/*"],"js":["parser.js","yahoo.js"]},
  {"matches":["https://nba-draft-helper.onrender.com/component/*"],"js":["transport.js","helper.js"],"all_frames":true}
 ]
}
